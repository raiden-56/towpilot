# Map tiles for the web map (Leaflet). The default OpenStreetMap tile servers are for
# development only — use a licensed provider (e.g. Mapbox raster tiles) in production:
# VITE_MAP_TILE_URL=https://api.mapbox.com/styles/v1/mapbox/streets-v12/tiles/256/{z}/{x}/{y}@2x?access_token=YOUR_PUBLIC_TOKEN
# VITE_MAP_ATTRIBUTION=© Mapbox © OpenStreetMap
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Dev server proxy target for /api and /socket.io
VITE_DEV_API_PROXY=http://localhost:4000
