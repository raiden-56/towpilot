// TowPilot data model.
// Conventions:
//  * All money is stored as integer paise (1 INR = 100 paise) to avoid float rounding.
//  * All timestamps are stored in UTC (timestamptz) and converted to the configured
//    display timezone (default Asia/Kolkata) at the edge.
//  * Financial records are never silently edited once settled; corrections are made
//    through compensating records (credit notes, refunds, adjustments).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

