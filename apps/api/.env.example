# ─── Core ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Local dev: `npm run db:local` starts a real PostgreSQL on port 5455.
DATABASE_URL=postgresql://towpilot:towpilot@127.0.0.1:5455/towpilot_dev?schema=public
# Optional. When unset, locks and the job queue use PostgreSQL only.
REDIS_URL=

APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# ─── Auth ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# ─── SMS / OTP ──────────────────────────────────────────────────────
# sandbox = OTPs are written to the API log only (never sent). msg91 = real SMS.
SMS_PROVIDER=sandbox
# Development convenience: return sandbox OTPs in the API response (ignored in production
# and ignored for any provider other than sandbox).
EXPOSE_SANDBOX_OTP=true
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=

# ─── Email ──────────────────────────────────────────────────────────
EMAIL_PROVIDER=sandbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TowPilot <no-reply@example.com>

PUSH_PROVIDER=sandbox

# ─── Payments ───────────────────────────────────────────────────────
# sandbox = simulated gateway (clearly labelled in the UI, never real money).
PAYMENT_PROVIDER=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SANDBOX_WEBHOOK_SECRET=sandbox-webhook-secret-not-for-production

# ─── Storage ────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
FILE_URL_SIGNING_SECRET=dev-file-signing-secret-change-me
MAX_UPLOAD_MB=15
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=

# ─── Maps ───────────────────────────────────────────────────────────
# sandbox = straight-line distance x road factor, no reverse geocoding (labelled as estimates)
# osm     = Nominatim geocoding + OSRM routing (respect their usage policies; dev/pilot only)
# google  = Google Geocoding + Distance Matrix (requires GOOGLE_MAPS_API_KEY)
MAPS_PROVIDER=sandbox
GOOGLE_MAPS_API_KEY=
OSM_CONTACT_EMAIL=

# ─── Ops ────────────────────────────────────────────────────────────
RUN_WORKER=true
LOG_LEVEL=info
ERROR_REPORTING_DSN=
# Development only: allows `npm run db:seed` to create labelled sample data.
ALLOW_SAMPLE_DATA=true

# Per-IP limits for OTP sends and sign-in attempts (per 15 minutes).
RATE_LIMIT_OTP_PER_15MIN=8
RATE_LIMIT_AUTH_PER_15MIN=30
