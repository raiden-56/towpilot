# Copy to .env.docker and fill in. Never commit the real file.
NODE_ENV=production
POSTGRES_PASSWORD=change-me-strong-db-password

APP_BASE_URL=https://towpilot.example.in
CORS_ORIGINS=https://towpilot.example.in
COOKIE_SECURE=true

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
FILE_URL_SIGNING_SECRET=

SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TowPilot <no-reply@towpilot.example.in>

PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=
# Licensed tile provider for the web map (OSM default tiles are for development only)
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

STORAGE_PROVIDER=local
LOG_LEVEL=info
ERROR_REPORTING_DSN=
ALLOW_SAMPLE_DATA=false
